    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  },
  "type": "module",
  "displayName": "LeseLaut German",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "aws-rum-web": {
      "uuid": "^11.1.1"
    },
    "undici": "^7.30.1",
    "fflate": "^0.8.2",
    "fast-uri": "^3.1.9",
